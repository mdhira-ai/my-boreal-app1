{
  "name": "my-boreal-app1",
  "version": "1.0.3",
  "description": "this is test app",
  "main": "main.js",
  "scripts": {
    "dev": "electron .",
    "watch:css": "npx @tailwindcss/cli -i ./style.css -o ./output.css --watch",
    "build": "electron-builder --win",
    "publish": "electron-builder --win --publish always"
  },
  "repository": {
    "url": "https://github.com/mdhira-ai/my-boreal-app1"
  },
  "build": {
    "appId": "com.mdhira.myborealapp1",
    "productName": "my-boreal-app1",
    "files": [
      "**/*",
      "!node_modules/.cache"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "publish": {
      "provider": "github",
      "owner": "mdhira-ai",
      "repo": "my-boreal-app1",
      "releaseType": "release"
    }
  },
  "keywords": [],
  "author": "md habibor rahman",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.9",
    "tailwindcss": "^4.3.3"
  }
}